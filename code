  document.querySelectorAll('.subnav-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.sub;
      const scope = btn.closest('.tab-panel') || document;
      scope.querySelectorAll('.subnav-item').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      scope.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));
      const panel = scope.querySelector('#' + CSS.escape(target));
      if (panel) panel.classList.add('active');
    });
  });

  // Inject a "See Implementation plan" button at the bottom of each
  // framework sub-panel that jumps to the matching implementation workstream
  const FRAMEWORK_TO_IMPL = {
    'career': 'impl-career',
    'recruitment': 'impl-recruitment',
    'onboarding': 'impl-onboarding',
    'commission': 'impl-commission',
    'routines': 'impl-routines',
    'dashboards': 'impl-dashboards',
    'method': 'impl-method',
    'process': 'impl-process',
    'dna': 'impl-dna',
    'workplace': 'impl-workplace'
  };

  document.querySelectorAll('#framework .sub-panel').forEach(panel => {
    const subId = panel.id;
    const targetImpl = FRAMEWORK_TO_IMPL[subId];
    if (!targetImpl) return;
    const row = document.createElement('div');
    row.className = 'see-impl-row';
    const btn = document.createElement('button');
    btn.className = 'see-impl-btn';
    btn.dataset.targetImpl = targetImpl;
    btn.innerHTML = 'See Implementation plan <span class="arrow">&rarr;</span>';
    row.appendChild(btn);
    panel.appendChild(row);
  });

  // Click handler: switch to the implementation tab and activate the
  // corresponding workstream sub-panel
  document.querySelectorAll('.see-impl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.targetImpl;

      // Switch top-level tab to implementation
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      const implTab = document.querySelector('.tab[data-tab="implementation"]');
      if (implTab) implTab.classList.add('active');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      const implPanel = document.getElementById('implementation');
      if (implPanel) implPanel.classList.add('active');

      // Activate matching sub-panel inside the implementation tab
      if (implPanel) {
        implPanel.querySelectorAll('.subnav-item').forEach(t => t.classList.remove('active'));
        const navBtn = implPanel.querySelector('.subnav-item[data-sub="' + target + '"]');
        if (navBtn) navBtn.classList.add('active');
        implPanel.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));
        const subPanel = document.getElementById(target);
        if (subPanel) subPanel.classList.add('active');
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // Clickable core element cards: open modal if data-modal is set, otherwise toggle inline details
  function openModal(id) {
    const m = document.getElementById('modal-' + id);
    if (m) {
      m.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }
  function closeAllModals() {
    document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('open'));
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.skel-card').forEach(card => {
    const modalId = card.dataset.modal;
    if (!card.querySelector('.card-chev')) {
      const chev = document.createElement('span');
      chev.className = 'card-chev';
      chev.textContent = modalId ? '\u2197' : '\u203A';
      card.appendChild(chev);
    }
    if (!modalId && !card.querySelector('.card-details')) {
      const details = document.createElement('div');
      details.className = 'card-details';
      details.textContent = 'Add detailed content for this element here.';
      card.appendChild(details);
    }
    card.addEventListener('click', () => {
      if (modalId) openModal(modalId);
      else card.classList.toggle('expanded');
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    // Skip sub-modal close buttons; they have their own handler that only closes the sub-modal
    if (btn.closest('.modal-overlay.sub-modal')) return;
    btn.addEventListener('click', closeAllModals);
  });

  // Rollout country tabs: switch which country panel is visible
  document.querySelectorAll('.country-tabs').forEach(tabsRow => {
    const card = tabsRow.closest('.rollout-card');
    if (!card) return;
    tabsRow.querySelectorAll('.country-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.country;
        tabsRow.querySelectorAll('.country-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        card.querySelectorAll('.country-panel').forEach(p => p.classList.remove('active'));
        const panel = card.querySelector('.country-panel[data-country="' + target + '"]');
        if (panel) panel.classList.add('active');
      });
    });
  });

  // Checklist items: toggle done state and update progress counter
  function updateCountryProgress(panel) {
    const items = panel.querySelectorAll('.checklist li');
    const done = panel.querySelectorAll('.checklist li.checked').length;
    const total = items.length;
    const doneEl = panel.querySelector('.done-count');
    const totalEl = panel.querySelector('.total-count');
    if (doneEl) doneEl.textContent = done;
    if (totalEl) totalEl.textContent = total;
  }
  document.querySelectorAll('.checklist li').forEach(item => {
    item.addEventListener('click', () => {
      item.classList.toggle('checked');
      const panel = item.closest('.country-panel');
      if (panel) updateCountryProgress(panel);
    });
  });
  document.querySelectorAll('.country-panel').forEach(updateCountryProgress);

  // Cross-section links inside modals: close modal, switch sub-nav, scroll to top
  document.querySelectorAll('.modal-link[data-target-sub]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeAllModals();
      const target = link.dataset.targetSub;
      document.querySelectorAll('.subnav-item').forEach(t => t.classList.remove('active'));
      const navBtn = document.querySelector('.subnav-item[data-sub="' + target + '"]');
      if (navBtn) navBtn.classList.add('active');
      document.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));
      const panel = document.getElementById(target);
      if (panel) panel.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
  document.querySelectorAll('.modal-overlay').forEach(m => {
    if (m.classList.contains('sub-modal')) return; // sub-modals get their own handler
    m.addEventListener('click', (e) => { if (e.target === m) closeAllModals(); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      // If a sub-modal is open, close just that one; otherwise close all
      const openSub = document.querySelector('.modal-overlay.sub-modal.open');
      if (openSub) {
        openSub.classList.remove('open');
        // restore body overflow only if no other modal is open
        if (!document.querySelector('.modal-overlay.open')) document.body.style.overflow = '';
      } else {
        closeAllModals();
      }
    }
  });

  // Sub-modal handling: buttons with data-submodal open a stacked modal on top of the parent
  document.querySelectorAll('[data-submodal]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const target = btn.dataset.submodal;
      const sub = document.getElementById('modal-' + target);
      if (sub) {
        sub.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  // Sub-modal close button: only close the sub-modal (not the parent)
  document.querySelectorAll('.modal-overlay.sub-modal .modal-close').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const sub = btn.closest('.modal-overlay');
      if (sub) sub.classList.remove('open');
      if (!document.querySelector('.modal-overlay.open')) document.body.style.overflow = '';
    });
  });

  // Sub-modal backdrop click: close just the sub-modal
  document.querySelectorAll('.modal-overlay.sub-modal').forEach(m => {
    m.addEventListener('click', (e) => {
      if (e.target === m) {
        m.classList.remove('open');
        if (!document.querySelector('.modal-overlay.open')) document.body.style.overflow = '';
      }
    });
  });

  // Country JD download placeholders: friendly message until files are wired up
  document.querySelectorAll('.country-dl-btn[data-jd]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.dataset.jd || '';
      const role = id.startsWith('bdm') ? 'BDM' : 'BDA';
      const country = btn.textContent.trim().replace(/[\u2193]/g, '').trim();
      alert('The ' + role + ' job description for ' + country + ' will be available here once the country JD file has been uploaded.');
    });
  });
</script>

</body>
</html>
