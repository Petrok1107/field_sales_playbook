<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Field Sales Playbook</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f4f4f1;
    --card: #ffffff;
    --border: #e7e7e2;
    --border-soft: #ececea;
    --text: #1d1f1a;
    --text-muted: #6b6f66;
    --text-faint: #9a9d93;
    --accent: #c8d834;
    --accent-deep: #4a5c1a;
    --accent-soft: #f1f4dc;
    --status-progress: #7b8db0;
    --status-progress-bg: #e8ecf3;
    --status-risk: #e23b3b;
    --status-risk-bg: #fbe6e6;
    --status-complete: #6f9b5e;
    --status-complete-bg: #e8efde;
    --status-cancel: #b0b0a8;
    --status-cancel-bg: #ececea;
    --status-pending: #c4b89a;
    --status-pending-bg: #efe9d9;
    --status-approval: #e8a13d;
    --status-approval-bg: #fbeed4;
    --shadow-sm: 0 1px 2px rgba(20,22,15,.04);
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg); color: var(--text);
    font-size: 14px; line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 18px 36px 0 36px;
  }
  .header-row {
    display: flex; align-items: center; gap: 24px; padding-bottom: 16px;
  }
  .logo {
    width: 44px; height: 44px; border-radius: 8px;
    background: var(--accent);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; color: #1d1f1a;
    font-size: 18px; letter-spacing: -0.02em; flex-shrink: 0;
  }
  .title-block h1 { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  .title-block .subtitle { color: var(--text-muted); font-size: 13px; margin-top: 2px; }
  .header-controls { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .filter, .search {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 14px;
    font-size: 13px; color: var(--text);
    display: flex; align-items: center; gap: 8px;
    height: 36px; cursor: pointer; font-family: inherit;
  }
  .filter { padding-right: 10px; min-width: 150px; justify-content: space-between; }
  .filter .chev { color: var(--text-muted); font-size: 11px; }
  .search { width: 240px; cursor: text; }
  .search input { border: 0; outline: 0; background: transparent; width: 100%; font-family: inherit; font-size: 13px; color: var(--text); }
  .search input::placeholder { color: var(--text-faint); }
  .meta { text-align: right; line-height: 1.3; }
  .meta .fy { font-size: 13px; color: var(--text); font-weight: 500; }
  .meta .updated { font-size: 12px; color: var(--text-faint); margin-top: 2px; }

  .tabs-row { display: flex; align-items: center; gap: 28px; }
  .tabs-left { display: flex; align-items: center; gap: 28px; }
  .tab {
    background: none; border: 0; padding: 12px 0;
    font-family: inherit; font-size: 14px;
    color: var(--text-muted); cursor: pointer;
    position: relative; font-weight: 500;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent-deep); font-weight: 600; }
  .tab.active::after {
    content: ''; position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 2px; background: var(--accent-deep);
    border-radius: 2px 2px 0 0;
  }

  .main { padding: 24px 36px 60px 36px; }

  .banner {
    background: var(--card); border-radius: 999px;
    padding: 14px 22px;
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 20px;
    border: 1px solid var(--border-soft);
  }
  .banner .dot { width: 8px; height: 8px; border-radius: 50%; background: #2a2a26; flex-shrink: 0; }
  .banner b { font-weight: 600; }
  .banner span { color: var(--text-muted); font-size: 13px; }

  .doc-intro {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 22px 26px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .doc-intro b { color: var(--text); font-weight: 600; }

  .section-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 18px; margin-bottom: 14px;
  }
  .section-header h2 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  .section-header .ctx {
    color: var(--text-faint); font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.06em;
    font-weight: 500; margin-bottom: 4px; display: block;
  }
  .section-header .tagline {
    color: var(--text-muted); font-size: 13px;
    font-style: italic; margin-top: 4px;
  }
  .pill {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 999px; padding: 6px 14px;
    font-size: 12px; color: var(--text-muted); white-space: nowrap;
  }

  .lead {
    margin: 0 0 8px 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .framework-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 980px) { .framework-layout { grid-template-columns: 1fr; } }

  .subnav {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 10px;
    box-shadow: var(--shadow-sm);
    position: sticky; top: 16px;
  }
  .subnav-title {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-faint); font-weight: 600;
    padding: 10px 12px 8px 12px;
  }
  .subnav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 8px;
    cursor: pointer; font-size: 13px; color: var(--text-muted);
    background: none; border: 0; width: 100%; text-align: left;
    font-family: inherit; line-height: 1.35;
  }
  .subnav-item:hover { background: #fafaf7; color: var(--text); }
  .subnav-item.active {
    background: var(--accent-soft); color: var(--accent-deep); font-weight: 600;
  }
  .subnav-item .num {
    font-size: 11px; color: var(--text-faint);
    font-weight: 600; letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0; width: 18px;
  }
  .subnav-item.active .num { color: var(--accent-deep); opacity: 0.75; }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 1280px) { .grid { grid-template-columns: 1fr; } }

  .card {
    background: var(--card); border: 1px solid var(--border-soft);
    border-radius: 14px; padding: 22px 24px;
    box-shadow: var(--shadow-sm);
  }
  .card-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
  .card-title { font-size: 15px; font-weight: 600; margin: 0; }
  .card-sub { color: var(--text-muted); font-size: 13px; margin: 2px 0 18px 0; }
  .card-meta {
    color: var(--text-faint); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
  }

  .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 22px; }
  .stat {
    background: #fafaf7; border: 1px solid var(--border-soft);
    border-radius: 10px; padding: 18px 20px;
  }
  .stat .num { font-size: 38px; font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  .stat .lbl {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); margin-top: 10px; font-weight: 500;
  }
  .stat .sub { font-size: 12px; color: var(--text-faint); margin-top: 2px; }

  .list-head {
    color: var(--text-faint); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
    display: flex; justify-content: space-between;
    padding: 14px 0 10px 0; border-top: 1px solid var(--border-soft);
  }
  .list-row {
    display: grid; grid-template-columns: 1.7fr 1.5fr 1fr auto;
    align-items: center; padding: 12px 0;
    border-top: 1px solid var(--border-soft); font-size: 13px;
    gap: 16px;
  }
  .list-row .name { font-weight: 500; }
  .list-row .meta-cell { color: var(--text-muted); }
  .list-row .count { color: var(--text-muted); text-align: right; white-space: nowrap; }

  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; }
  .status::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: var(--status-progress);
  }
  .status.risk::before { background: var(--status-risk); }
  .status.complete::before { background: var(--status-complete); }
  .status.cancel::before { background: var(--status-cancel); }
  .status.pending::before { background: var(--status-pending); }
  .status.approval::before { background: var(--status-approval); }

  .stack-bar {
    height: 8px; border-radius: 999px;
    background: var(--border-soft);
    display: flex; overflow: hidden;
    margin-bottom: 18px;
  }
  .stack-bar > span { display: block; height: 100%; }

  .legend-row {
    display: grid; grid-template-columns: 1fr auto auto;
    align-items: center; gap: 16px;
    padding: 11px 14px; border-radius: 10px;
    margin-bottom: 6px; font-size: 13px;
  }
  .legend-row.progress { background: var(--status-progress-bg); color: #41527a; }
  .legend-row.risk { background: var(--status-risk-bg); color: #b22a2a; }
  .legend-row.complete { background: var(--status-complete-bg); color: #4f7b3f; }
  .legend-row.cancel { background: var(--status-cancel-bg); color: #65655e; }
  .legend-row.pending { background: var(--status-pending-bg); color: #7e6f4d; }
  .legend-row.approval { background: var(--status-approval-bg); color: #a16e1e; }
  .legend-row .lbl-dot { display: flex; align-items: center; gap: 10px; font-weight: 500; }
  .legend-row .lbl-dot::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: currentColor; opacity: 0.85;
  }
  .legend-row .pct { font-size: 12px; opacity: 0.75; }
  .legend-row .num { font-weight: 600; font-size: 15px; min-width: 28px; text-align: right; }

  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .skel-card {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 22px;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .skel-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(20,22,15,.07);
    transform: translateY(-1px);
  }
  .skel-card h3 { margin: 0 0 6px 0; font-size: 14px; font-weight: 600; color: var(--text); padding-right: 24px; }
  .skel-card p { margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5; }
  .skel-card .card-chev {
    position: absolute;
    top: 20px;
    right: 22px;
    color: var(--text-faint);
    font-size: 18px;
    line-height: 1;
    font-weight: 400;
    transition: transform 0.2s ease, color 0.15s ease;
    pointer-events: none;
  }
  .skel-card:hover .card-chev { color: var(--accent-deep); }
  .skel-card.expanded .card-chev { transform: rotate(90deg); color: var(--accent-deep); }
  .skel-card .card-details {
    display: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border-soft);
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .skel-card.expanded .card-details { display: block; }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20,22,15,0.45);
    z-index: 1000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: 40px 20px;
  }
  .modal-overlay.open { display: flex; }
  .modal-dialog {
    background: var(--card);
    border-radius: 16px;
    max-width: 1100px;
    width: 100%;
    padding: 32px 40px 36px 40px;
    position: relative;
    box-shadow: 0 24px 60px rgba(20,22,15,0.25);
    margin: auto;
  }
  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
  }
  .modal-close:hover { background: #fafaf7; color: var(--text); border-color: var(--text-muted); }
  .modal-eyebrow {
    color: var(--text-faint);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }
  .modal-header h2 {
    margin: 0 0 18px 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .modal-body p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 14px 0;
  }
  .modal-body p b, .modal-body p strong { color: var(--text); font-weight: 600; }

  /* Role evolution table */
  .role-table-wrap { margin-top: 22px; overflow-x: auto; }
  .role-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
  .role-table th, .role-table td {
    text-align: left;
    padding: 12px 14px;
    vertical-align: middle;
  }
  .role-table thead .group-row th {
    font-weight: 700;
    font-size: 13px;
    padding: 10px 14px;
    border-bottom: 0;
  }
  .role-table thead .group-row .group-conditions {
    background: #d8e07a; color: #4a5c1a;
    border-radius: 6px 6px 0 0;
  }
  .role-table thead .group-row .group-expectations {
    background: #b9dfe9; color: #2c6477;
    border-radius: 6px 6px 0 0;
  }
  .role-table thead .col-row th {
    font-weight: 600;
    font-size: 12px;
    color: var(--text-muted);
    background: #fafaf7;
    border-bottom: 1px solid var(--border-soft);
    border-top: 1px solid var(--border-soft);
  }
  .role-table tbody td {
    border-bottom: 1px solid var(--border-soft);
    color: var(--text);
  }
  .role-table tbody tr:nth-child(even) td { background: #fafaf7; }
  .role-table tbody td.lvl { color: #2a8aa3; font-weight: 700; font-size: 12.5px; }
  .role-table tbody td.title { font-weight: 700; }
  .role-table tbody td.target { font-weight: 700; }
  .role-table tbody tr:last-child td { border-bottom: 0; }

  /* Training by level — horizontal grid (levels as columns) */
  .training-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-top: 14px;
  }
  .training-col {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 0 0 12px 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .training-arrow {
    background: #c8d834;
    padding: 8px 14px 8px 18px;
    font-weight: 700;
    font-size: 11.5px;
    color: #1d1f1a;
    text-align: center;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 0 100%, 10px 50%);
    margin-bottom: 10px;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .training-arrow .lvl-tag {
    display: block;
    font-size: 9.5px;
    font-weight: 600;
    opacity: 0.7;
    letter-spacing: 0.06em;
    margin-bottom: 1px;
  }
  .training-objective {
    padding: 0 12px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 8px;
    min-height: 32px;
  }
  .training-bullets {
    margin: 0;
    padding: 0 10px 0 22px;
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .training-bullets li { margin-bottom: 5px; }
  .training-bullets li:last-child { margin-bottom: 0; }
  .training-row-label {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 12px;
    margin-bottom: 4px;
  }
  @media (max-width: 800px) {
    .training-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Lateral move support — compact aligned grid table (rows = aspects) */
  .lateral-table {
    margin-top: 14px;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    overflow: hidden;
  }
  .lateral-row {
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    align-items: stretch;
    border-bottom: 1px solid var(--border-soft);
  }
  .lateral-row:last-child { border-bottom: 0; }
  .lateral-row.header {
    background: #c8d834;
    font-weight: 700;
    font-size: 12px;
    color: #1d1f1a;
    letter-spacing: 0.01em;
  }
  .lateral-row.header .lateral-cell { padding: 11px 16px; align-self: center; }
  .lateral-cell {
    padding: 14px 16px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .lateral-cell.aspect {
    font-weight: 700;
    color: var(--text);
    font-size: 12.5px;
  }
  .lateral-cell.approach { border-left: 1px solid var(--border-soft); }
  .lateral-cell.coaching {
    border-left: 1px solid var(--border-soft);
    background: #fafaf7;
  }
  .lateral-row.header .lateral-cell.approach,
  .lateral-row.header .lateral-cell.coaching {
    border-left: 1px solid rgba(29,31,26,0.15);
    background: transparent;
  }
  .lateral-cell ul {
    margin: 0;
    padding: 0 0 0 18px;
  }
  .lateral-cell li { margin-bottom: 4px; }
  .lateral-cell li:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .lateral-row { grid-template-columns: 1fr; }
    .lateral-cell.approach, .lateral-cell.coaching {
      border-left: 0;
      border-top: 1px solid var(--border-soft);
    }
  }

  /* Modal: ordered/unordered lists and dimension sections */
  .modal-list {
    margin: 4px 0 14px 0;
    padding: 0 0 0 22px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .modal-list li { margin-bottom: 6px; }
  .modal-list li b { color: var(--text); font-weight: 600; }

  .modal-sections {
    margin-top: 22px;
    display: grid;
    gap: 14px;
  }
  .modal-section {
    background: #fafaf7;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 22px 24px;
    position: relative;
  }
  .modal-section .section-eyebrow {
    color: var(--text-faint);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 4px;
    display: block;
  }
  .modal-section h3 {
    margin: 0 0 10px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .modal-section p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 10px 0;
  }
  .modal-section p:last-child { margin-bottom: 0; }
  .modal-section p b { color: var(--text); font-weight: 600; }

  .kpi-list {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0 0 12px 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .kpi-list li {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12.5px;
    color: var(--text);
    font-weight: 600;
  }

  /* Skills/behaviours progression grid: levels as arrow columns, bullets below */
  .progression-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    margin-top: 14px;
  }
  .progression-col {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 0 0 12px 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .progression-arrow {
    background: #c8d834;
    padding: 8px 14px 8px 18px;
    font-weight: 700;
    font-size: 11.5px;
    color: #1d1f1a;
    text-align: center;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 0 100%, 10px 50%);
    margin-bottom: 10px;
    letter-spacing: 0.01em;
  }
  .progression-bullets {
    margin: 0;
    padding: 0 10px 0 22px;
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .progression-bullets li { margin-bottom: 5px; }
  .progression-bullets li:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .progression-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Inline link inside modals (e.g. cross-section navigation) */
  .modal-link {
    color: #2a8aa3;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid rgba(42,138,163,0.3);
    transition: border-color 0.15s ease, color 0.15s ease;
    cursor: pointer;
  }
  .modal-link:hover { color: #1d6e85; border-bottom-color: #1d6e85; }

  /* Calendar timeline (Promotion decisions) */
  .calendar-wrap {
    margin-top: 14px;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 18px 20px;
  }
  .calendar-wrap svg { width: 100%; height: auto; display: block; }

  /* Promotion process: 4 element boxes, each with In-cycle / Off-cycle columns */
  .promo-process-section {
    margin-top: 18px;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 20px 22px;
  }
  .promo-process-section + .promo-process-section { margin-top: 14px; }
  .promo-process-section > .section-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
  }
  .promo-process-section > .section-intro {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 16px 0;
  }
  .promo-process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: stretch;
  }
  .promo-process-col {
    border-radius: 10px;
    padding: 20px 22px;
    border: 1px solid var(--border-soft);
  }
  .promo-process-col.in-cycle { background: #f4f4f0; }
  .promo-process-col.off-cycle { background: #f8f8d6; }
  .promo-process-col > h4 {
    margin: 0 0 14px 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .promo-process-col.in-cycle > h4 { color: #2a8aa3; }
  .promo-process-col.off-cycle > h4 { color: #8a9a14; }
  .promo-process-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: promo-step;
  }
  .promo-process-list > li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
    counter-increment: promo-step;
  }
  .promo-process-list > li:last-child { margin-bottom: 0; }
  .promo-process-list > li::before {
    content: counter(promo-step);
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    font-size: 13px;
    line-height: 1.55;
  }
  .promo-process-col.in-cycle .promo-process-list > li::before { color: #2a8aa3; }
  .promo-process-col.off-cycle .promo-process-list > li::before { color: #8a9a14; }
  .promo-process-list > li > .item-title {
    display: block;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
  }
  .promo-process-col p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 10px 0;
  }
  .promo-process-col p:last-child { margin-bottom: 0; }
  .promo-process-col .sub-heading {
    font-size: 13px;
    font-weight: 700;
    margin: 12px 0 8px 0;
  }
  .promo-process-col.in-cycle .sub-heading { color: #2a8aa3; }
  .promo-process-col.off-cycle .sub-heading { color: #8a9a14; }
  .promo-process-bullets {
    margin: 0;
    padding: 0 0 0 18px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .promo-process-bullets li { margin-bottom: 4px; }
  .promo-process-bullets li:last-child { margin-bottom: 0; }
  .promo-process-col .download-link {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    background: #c8d834;
    color: #4a5410;
    border: 1px solid #b6c52e;
    transition: background 0.15s ease;
  }
  .promo-process-col .download-link:hover {
    background: #b6c52e;
  }
  .promo-process-col .download-link::before {
    content: "↓ ";
    font-weight: 700;
  }
  @media (max-width: 800px) {
    .promo-process-grid { grid-template-columns: 1fr; }
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  .sub-panel { display: none; }
  .sub-panel.active { display: block; }

  .subsection { margin-top: 28px; }
  .subsection-title {
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-muted); font-weight: 600; margin: 0 0 14px 0;
  }

  .stages {
    display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .stage {
    background: var(--card); border: 1px solid var(--border-soft);
    border-radius: 12px; padding: 16px;
    box-shadow: var(--shadow-sm);
  }
  .stage .step {
    color: var(--text-faint); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .stage .name { margin-top: 6px; font-weight: 600; font-size: 14px; line-height: 1.3; }

  ul.highlights {
    list-style: none;
    padding: 0; margin: 0;
    display: grid; gap: 8px;
  }
  ul.highlights li {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 12px 16px 12px 36px;
    position: relative;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }
  ul.highlights li::before {
    content: '';
    position: absolute;
    left: 16px; top: 18px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Plan cards (per-workstream) */
  .plan-card {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 16px;
  }
  .plan-card-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 16px; gap: 18px;
  }
  .plan-card-head h3 {
    margin: 0; font-size: 17px; font-weight: 600;
    letter-spacing: -0.01em;
  }
  .plan-card-head .ctx {
    color: var(--text-faint); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
    margin-bottom: 4px; display: block;
  }
  .plan-owner {
    color: var(--text-muted); font-size: 12px;
    background: #fafaf7; border: 1px solid var(--border-soft);
    border-radius: 999px; padding: 6px 12px;
    white-space: nowrap;
  }
  .plan-owner b { color: var(--text); font-weight: 600; }

  .impl-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 1100px) { .impl-layout { grid-template-columns: 1fr; } }
  .impl-side { position: sticky; top: 16px; }

  /* Rollout status block (country sub-menus + checklist) */
  .rollout-card {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 22px;
  }
  .rollout-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; margin-bottom: 6px;
  }
  .rollout-head h3 {
    margin: 0; font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
  }
  .rollout-head .ctx {
    color: var(--text-faint); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
    margin-bottom: 4px; display: block;
  }
  .rollout-intro {
    color: var(--text-muted); font-size: 13px; line-height: 1.55;
    margin: 4px 0 16px 0;
  }
  .country-tabs {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 6px; background: #fafaf7;
    border: 1px solid var(--border-soft); border-radius: 12px;
    margin-bottom: 18px;
  }
  .country-tab {
    background: transparent; border: 0; cursor: pointer;
    padding: 8px 14px; border-radius: 8px;
    font-family: inherit; font-size: 13px; font-weight: 500;
    color: var(--text-muted); line-height: 1.2;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .country-tab:hover { background: #f0f0ec; color: var(--text); }
  .country-tab.active {
    background: var(--card); color: var(--accent-deep);
    font-weight: 600; box-shadow: var(--shadow-sm);
  }
  .country-panel { display: none; }
  .country-panel.active { display: block; }
  .country-panel-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px; gap: 12px;
  }
  .country-panel-head h4 {
    margin: 0; font-size: 14px; font-weight: 600; letter-spacing: -0.005em;
  }
  .country-progress {
    font-size: 12px; color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .country-progress b { color: var(--accent-deep); font-weight: 700; }
  .checklist {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .checklist li {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border: 1px solid var(--border-soft);
    border-radius: 10px; background: #fdfdfa;
    cursor: pointer; transition: background 0.12s ease, border-color 0.12s ease;
    font-size: 13px; line-height: 1.45; color: var(--text);
  }
  .checklist li:hover { background: #fafaf3; border-color: var(--border); }
  .checklist li .check-box {
    flex-shrink: 0; width: 18px; height: 18px;
    border: 1.5px solid #c8c9c0; border-radius: 5px;
    display: inline-flex; align-items: center; justify-content: center;
    background: #ffffff; margin-top: 1px;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .checklist li .check-box::after {
    content: ''; width: 6px; height: 10px;
    border-right: 2px solid #ffffff; border-bottom: 2px solid #ffffff;
    transform: rotate(45deg) scale(0); transform-origin: center;
    transition: transform 0.12s ease; margin-bottom: 2px;
  }
  .checklist li.checked {
    background: var(--status-complete-bg); border-color: #c4d5b3;
  }
  .checklist li.checked .check-box {
    background: var(--status-complete); border-color: var(--status-complete);
  }
  .checklist li.checked .check-box::after { transform: rotate(45deg) scale(1); }
  .checklist li.checked .check-text {
    color: var(--text-muted); text-decoration: line-through;
  }
  .check-text { flex: 1; }

  /* See Implementation plan button (footer of framework sub-panels) */
  .see-impl-row {
    display: flex; justify-content: flex-end;
    margin-top: 28px; padding-top: 22px;
    border-top: 1px solid var(--border-soft);
  }
  .see-impl-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--accent-deep); color: #ffffff;
    border: 0; border-radius: 999px;
    padding: 11px 20px; font-family: inherit;
    font-size: 13px; font-weight: 600;
    cursor: pointer; letter-spacing: 0.01em;
    transition: background 0.15s ease, transform 0.1s ease;
    box-shadow: var(--shadow-sm);
  }
  .see-impl-btn:hover { background: #3a4914; transform: translateY(-1px); }
  .see-impl-btn .arrow {
    font-size: 14px; line-height: 1;
    transition: transform 0.15s ease;
  }
  .see-impl-btn:hover .arrow { transform: translateX(2px); }

  /* ========== ADDED: framework section content (intros, process flows, sub-modals, country JD buttons) ========== */
  .lead-block { margin: 14px 0 22px 0; padding: 0; color: var(--text-muted); font-size: 14px; line-height: 1.6; }
  .lead-block p { margin: 0 0 10px 0; }
  .lead-block p:last-child { margin-bottom: 0; }
  .lead-block b, .lead-block strong { color: var(--text); font-weight: 600; }

  /* Modal CTA button (opens a sub-modal from within a modal) */
  .modal-cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 4px 0; }
  .modal-cta {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px;
    font-size: 13px; font-weight: 600;
    background: var(--accent);
    color: #1a1a1a;
    border: 1px solid var(--accent-deep);
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
    font-family: inherit;
  }
  .modal-cta:hover { background: var(--accent-deep); color: #fff; transform: translateY(-1px); }
  .modal-cta::after { content: "\2197"; font-weight: 700; }

  /* Process flow (horizontal 4-step) */
  .process-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 14px 0 8px 0;
  }
  .process-step {
    background: #fafaf6;
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px 14px 12px;
    position: relative;
  }
  .process-step .pstep-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--accent); color: #1a1a1a;
    font-weight: 700; font-size: 12px;
    margin-bottom: 8px;
  }
  .process-step h4 { margin: 0 0 4px 0; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .process-step p { margin: 0; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
  .process-step::after {
    content: "\2192"; position: absolute; right: -14px; top: 50%; transform: translateY(-50%);
    color: var(--accent-deep); font-size: 18px; font-weight: 700;
    background: var(--card); padding: 0 2px; z-index: 2;
  }
  .process-step:last-child::after { display: none; }
  @media (max-width: 800px) {
    .process-flow { grid-template-columns: 1fr; }
    .process-step::after { display: none; }
  }

  /* Country JD download row (9 country buttons) */
  .country-dl-row {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin: 8px 0 6px 0;
  }
  .country-dl-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px;
    font-size: 12.5px; font-weight: 600;
    background: #fafaf6; color: var(--text);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .country-dl-btn:hover { background: var(--accent); border-color: var(--accent-deep); }
  .country-dl-btn .flag { font-size: 14px; }
  .country-dl-btn .dl-icon { font-weight: 700; color: var(--accent-deep); }

  /* Numbered card grid (Sales tracking views) */
  .numbered-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
    margin: 12px 0 8px 0;
  }
  .num-card {
    display: grid; grid-template-columns: 44px 1fr; gap: 14px;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .num-card:hover { border-color: var(--accent-deep); transform: translateY(-1px); box-shadow: 0 2px 6px rgba(0,0,0,0.04); }
  .num-card .num {
    background: var(--accent); color: #1a1a1a; font-weight: 700;
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .num-card h4 { margin: 0 0 4px 0; font-size: 14px; font-weight: 600; color: var(--text); }
  .num-card p { margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5; }
  @media (max-width: 800px) {
    .numbered-grid { grid-template-columns: 1fr; }
  }

  /* Sub-section title inside frame sections */
  .frame-subsection { margin: 22px 0 8px 0; }
  .frame-subsection h3 { margin: 0 0 6px 0; font-size: 15px; font-weight: 600; color: var(--text); }
  .frame-subsection .frame-sub-intro { margin: 0 0 10px 0; font-size: 13.5px; color: var(--text-muted); line-height: 1.6; }

  /* Two-column split (Execution-driven vs Development-focused) */
  .two-col-split { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 12px 0; }
  @media (max-width: 900px) { .two-col-split { grid-template-columns: 1fr; } }

  /* EVP pillars visualization (5 pillars in a row) */
  .evp-pillars {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0;
    margin: 14px 0;
  }
  .evp-pillar {
    background: transparent;
    border: 0;
    border-left: 1px solid var(--border-soft);
    border-radius: 0;
    padding: 14px 14px 16px 14px;
    text-align: left;
  }
  .evp-pillar:first-child { border-left: 0; }
  .evp-pillar .pp-num {
    font-size: 26px; font-weight: 800; color: var(--accent-deep);
    letter-spacing: 0; line-height: 1; margin-bottom: 14px;
  }
  .evp-pillar h5 {
    margin: 0 0 10px 0; font-size: 14px; font-weight: 700;
    color: var(--text); line-height: 1.25;
    min-height: calc(14px * 1.25 * 2);
  }
  .evp-pillar .pp-sub {
    font-size: 12px; font-weight: 600; font-style: italic;
    color: #1a8a8a; line-height: 1.35; margin: 0 0 16px 0;
    min-height: calc(12px * 1.35 * 2);
  }
  .evp-pillar ul {
    list-style: none; padding: 0; margin: 0;
    font-size: 12px; color: var(--text-muted); line-height: 1.7;
  }
  .evp-pillar ul li { margin: 0; }
  @media (max-width: 800px) {
    .evp-pillars { grid-template-columns: repeat(2, 1fr); }
    .evp-pillar { border-left: 0; border-top: 1px solid var(--border-soft); }
    .evp-pillar:first-child { border-top: 0; }
  }

  /* Profile dimensions (5 categories as stacked rows, used in Agent profile modal) */
  .profile-dims {
    display: flex; flex-direction: column;
    margin: 14px 0;
    border-top: 1px solid var(--border-soft);
  }
  .profile-dim {
    display: grid;
    grid-template-columns: 60px 1.4fr 1.6fr 2.4fr;
    align-items: center;
    gap: 18px;
    padding: 16px 6px;
    border-bottom: 1px solid var(--border-soft);
    background: transparent;
    border-left: 0; border-right: 0;
    border-radius: 0;
    text-align: left;
  }
  .profile-dim .dim-icon {
    width: auto; height: auto; border-radius: 0; background: transparent;
    margin: 0; display: block; text-align: left;
    font-weight: 800; color: var(--accent-deep); font-size: 26px; line-height: 1;
  }
  .profile-dim h5 {
    margin: 0; font-size: 14px; font-weight: 700;
    color: var(--text); line-height: 1.3;
  }
  .profile-dim .pd-sub {
    font-size: 13px; font-weight: 600; font-style: italic;
    color: #1a8a8a; line-height: 1.4;
  }
  .profile-dim .pd-desc {
    font-size: 13px; color: var(--text-muted); line-height: 1.5;
  }
  @media (max-width: 800px) {
    .profile-dim {
      grid-template-columns: 50px 1fr;
      grid-template-areas:
        "num title"
        "num sub"
        "num desc";
      row-gap: 4px;
    }
    .profile-dim .dim-icon { grid-area: num; }
    .profile-dim h5 { grid-area: title; }
    .profile-dim .pd-sub { grid-area: sub; }
    .profile-dim .pd-desc { grid-area: desc; }
  }

  /* Ashby-style scorecard example */
  .ashby-meta {
    font-size: 13px; color: var(--text); line-height: 1.7;
    margin: 8px 0 14px 0;
  }
  .ashby-meta b { font-weight: 600; }
  .score-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 22px; height: 22px; padding: 0 6px;
    border-radius: 4px; font-weight: 700; font-size: 12.5px;
    color: #1d1f1a; vertical-align: middle;
  }
  .score-badge.s4 { background: #c8d834; }
  .score-badge.s3 { background: #e8eda8; }
  .score-badge.s2 { background: #f5c1c1; color: #7a1f1f; }
  .score-badge.s1 { background: #e58a8a; color: #fff; }
  .ashby-card {
    background: #fafaf6;
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 16px 18px;
    margin: 10px 0 14px 0;
  }
  .ashby-card .ac-row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 12px;
  }
  .ashby-card h4 {
    margin: 0 0 2px 0; font-size: 14px; font-weight: 700;
  }
  .ashby-card .ac-date {
    margin: 0; font-size: 12px; color: var(--text-muted);
  }
  .ashby-card .ac-avg {
    font-size: 12.5px; color: var(--text-muted);
  }
  .ashby-feedback {
